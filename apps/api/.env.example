# --- Database ---
DATABASE_URL="postgresql://devraj.patil.in@localhost:5433/tokri?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- OTP / SMS (mock mode by default) ---
# Set MOCK_OTP=false and fill MSG91_AUTH_KEY + MSG91_TEMPLATE_ID once DLT approval lands.
MOCK_OTP="true"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="TOKRIN"
TURNSTILE_SECRET_KEY=""

# --- Email OTP (free, used for login now instead of phone SMS) ---
MOCK_EMAIL_OTP="true"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Firebase Phone Auth (free OTP alternative to MSG91) ---
# Only used by POST /auth/firebase/verify, which the frontend calls when
# NEXT_PUBLIC_FIREBASE_API_KEY is set. From Firebase console > Project settings
# > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Payments (mock Razorpay by default) ---
MOCK_PAYMENTS="true"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- LLM (mock fallback used if absent) ---
GEMINI_API_KEY=""

# --- App ---
PORT="4000"
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
