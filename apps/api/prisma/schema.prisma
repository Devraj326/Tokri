generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum CartType {
  solo
  shared
}

enum CartStatus {
  open
  locked
  ordered
  expired
}

enum CartMemberRole {
  host
  member
  viewer
}

enum SplitMode {
  host_pays_all
  pay_for_own
  split_equally
  custom
}

enum CartItemSource {
  manual
  kit
}

enum ReactionValue {
  up
  down
}

enum KitGoalType {
  recipe
  repair
  project
  occasion
  household
}

enum KitItemBucket {
  in_stock
  swap
  not_on_tokri
  probably_at_home
}

enum OrderStatus {
  confirmed
  packing
  out_for_delivery
  delivered
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum PantryKind {
  pantry
  tool
}

enum CouponType {
  flat
  percent
}

// ---------- Core models ----------

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  refreshTokens  RefreshToken[]
  addresses      Address[]
  hostedCarts    Cart[]            @relation("CartHost")
  cartMembers    CartMember[]
  cartItemsAdded CartItem[]
  reactions      CartItemReaction[]
  kits           Kit[]
  pantryItems    PantryItem[]
  orders         Order[]
  payments       Payment[]
  reviews        Review[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  label   String
  lat     Float
  lng     Float
  line1   String
  storeId String? @map("store_id")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id])
  carts Cart[]

  @@map("addresses")
}

model Store {
  id         String   @id @default(uuid())
  name       String
  lat        Float
  lng        Float
  radiusKm   Float    @default(5) @map("radius_km")
  isOpen     Boolean  @default(true) @map("is_open")

  addresses  Address[]
  carts      Cart[]
  inventory  Inventory[]
  orders     Order[]

  @@map("stores")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  hindiName String?   @map("hindi_name")
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id         String   @id @default(uuid())
  name       String
  hindiName  String?  @map("hindi_name")
  aliases    String[] @default([])
  categoryId String   @map("category_id")
  brand      String?
  unit       String
  images     String[] @default([])
  tileColor  String   @default("haldi") @map("tile_color")
  isVeg      Boolean?  @map("is_veg")
  subcategory String? @map("subcategory")
  embedding  Json?

  category Category  @relation(fields: [categoryId], references: [id])
  variants Variant[]
  reviews  Review[]

  @@index([name])
  @@map("products")
}

model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  orderId   String?  @map("order_id")
  rating    Int
  text      String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([productId, userId, orderId])
  @@index([productId])
  @@map("reviews")
}

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  description   String?
  discountType  CouponType @map("discount_type")
  value         Float
  minOrderValue Float?     @map("min_order_value")
  maxDiscount   Float?     @map("max_discount")
  isActive      Boolean    @default(true) @map("is_active")
  expiresAt     DateTime?  @map("expires_at")
  usageLimit    Int?       @map("usage_limit")
  usedCount     Int        @default(0) @map("used_count")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("coupons")
}

model Variant {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  size      String
  mrp       Float
  price     Float

  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  cartItems      CartItem[]
  kitItems       KitItem[]

  @@map("variants")
}

model Inventory {
  storeId      String @map("store_id")
  variantId    String @map("variant_id")
  qtyAvailable Int    @default(0) @map("qty_available")
  qtyReserved  Int    @default(0) @map("qty_reserved")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([storeId, variantId])
  @@map("inventory")
}

model ProductAlias {
  id      String @id @default(uuid())
  alias   String
  canonical String

  @@index([alias])
  @@map("product_aliases")
}

// ---------- Carts ----------

model Cart {
  id         String     @id @default(uuid())
  type       CartType
  name       String?
  hostId     String     @map("host_id")
  storeId    String     @map("store_id")
  addressId  String?    @map("address_id")
  status     CartStatus @default(open)
  couponCode String?    @map("coupon_code")
  budgetCap  Float?     @map("budget_cap")
  splitMode  SplitMode  @default(host_pays_all) @map("split_mode")
  inviteCode String?    @unique @map("invite_code")
  version    Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  lockedAt   DateTime?  @map("locked_at")
  expiresAt  DateTime   @map("expires_at")

  host    User     @relation("CartHost", fields: [hostId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  members CartMember[]
  items   CartItem[]
  orders  Order[]
  kits    Kit[]

  @@map("carts")
}

model CartMember {
  cartId   String         @map("cart_id")
  userId   String         @map("user_id")
  role     CartMemberRole @default(member)
  color    String
  isDone   Boolean        @default(false) @map("is_done")
  joinedAt DateTime       @default(now()) @map("joined_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cartId, userId])
  @@map("cart_members")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String         @map("cart_id")
  variantId String         @map("variant_id")
  addedBy   String         @map("added_by")
  qty       Int            @default(1)
  note      String?
  source    CartItemSource @default(manual)
  createdAt DateTime       @default(now()) @map("created_at")

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant  @relation(fields: [variantId], references: [id])
  adder   User     @relation(fields: [addedBy], references: [id])

  reactions CartItemReaction[]

  @@map("cart_items")
}

model CartItemReaction {
  cartItemId String        @map("cart_item_id")
  userId     String        @map("user_id")
  value      ReactionValue

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cartItemId, userId])
  @@map("cart_item_reactions")
}

// ---------- AI Kit ----------

model Kit {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  cartId     String?     @map("cart_id")
  prompt     String
  goalType   KitGoalType @map("goal_type")
  servings   Int?
  normalizedKey String   @map("normalized_key")
  llmOutput  Json        @map("llm_output")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart Cart? @relation(fields: [cartId], references: [id])

  items KitItem[]

  @@index([normalizedKey])
  @@map("kits")
}

model KitItem {
  id               String        @id @default(uuid())
  kitId            String        @map("kit_id")
  name             String
  hindiAlias       String?       @map("hindi_alias")
  qty              Float
  unit             String
  essential        Boolean       @default(true)
  bucket           KitItemBucket
  reason           String?
  matchedVariantId String?       @map("matched_variant_id")
  confidence       Float         @default(0)

  kit             Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  matchedVariant  Variant? @relation(fields: [matchedVariantId], references: [id])

  @@map("kit_items")
}

model PantryItem {
  id     String     @id @default(uuid())
  userId String     @map("user_id")
  name   String
  kind   PantryKind @default(pantry)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pantry_items")
}

// ---------- Orders & payments ----------

model Order {
  id        String      @id @default(uuid())
  cartId    String      @map("cart_id")
  storeId   String      @map("store_id")
  userId    String      @map("user_id")
  total     Float
  status    OrderStatus @default(confirmed)
  riderName String?     @map("rider_name")
  eta       DateTime?
  createdAt DateTime    @default(now()) @map("created_at")

  cart  Cart  @relation(fields: [cartId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  payments Payment[]
  reviews  Review[]

  @@map("orders")
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String        @map("order_id")
  payerId      String        @map("payer_id")
  amount          Float
  razorpayOrderId String?       @map("razorpay_order_id")
  razorpayRef     String?       @map("razorpay_ref")
  status          PaymentStatus @default(pending)
  createdAt    DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payer User  @relation(fields: [payerId], references: [id])

  @@map("payments")
}
